# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Required. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Any OpenAI model that supports tool calling (defaults to gpt-6-luna).
OPENAI_MODEL=gpt-6-luna

# Required. Create a key at https://app.tavily.com
TAVILY_API_KEY=

# Optional. One of DEBUG, INFO, WARNING, ERROR (defaults to INFO).
# LOG_LEVEL=INFO
